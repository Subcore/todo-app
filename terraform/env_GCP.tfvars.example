# GCP Infrastructure Variables
# Copy to env_GCP.tfvars and fill in real values:
#   cp env_GCP.tfvars.example env_GCP.tfvars
#
# Usage:
#   terraform apply -var-file=env_GCP.tfvars

project_id        = "your-gcp-project-id"
region            = "asia-southeast1"
zone              = "asia-southeast1-b"

github_owner      = "Subcore"
github_repository = "todo-app-v2"
github_token      = "ghp_your_github_pat_token"

db_password       = "YourStrongPassword123!"
