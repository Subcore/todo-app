FROM nginx:1.27-alpine

ARG GIT_SHA=unknown

# Удаляем дефолтный конфиг
RUN rm /etc/nginx/conf.d/default.conf

# Копируем наш конфиг
COPY web/nginx.conf /etc/nginx/conf.d/default.conf

# Копируем статику
COPY web/index.html /usr/share/nginx/html/index.html.template
COPY web/docs.html /usr/share/nginx/html/
COPY web/assets/ /usr/share/nginx/html/assets/

# Подставляем git commit SHA в шаблон
RUN sed -i "s/__GIT_SHA__/${GIT_SHA}/g" /usr/share/nginx/html/index.html.template

# BASE_HREF по умолчанию "/" — для docker-compose
# В Kubernetes через env переменную выставляется "/web/"
ENV BASE_HREF="/"

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

# При старте подставляем BASE_HREF в index.html и запускаем nginx
CMD ["/bin/sh", "-c", "envsubst '${BASE_HREF}' < /usr/share/nginx/html/index.html.template > /usr/share/nginx/html/index.html && nginx -g 'daemon off;'"]
