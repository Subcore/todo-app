[Unit]
Description=Todo API Server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_user }}
WorkingDirectory={{ app_dir }}
EnvironmentFile={{ app_dir }}/.env
ExecStart={{ app_dir }}/todo-api
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
