# API Gateway
server {
    listen 80;
    server_name {{ server_ip }};

    location /web/ {
        proxy_pass http://127.0.0.1:{{ web_port }}/;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:{{ app_port }};
    }
}

# Web Nginx
server {
    listen 127.0.0.1:{{ web_port }};
    root {{ web_dir }};
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }
}
